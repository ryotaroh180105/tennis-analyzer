# 本番/実機接続時に上書きする環境変数。docker-compose.ymlのdevデフォルトは
# そのまま動くようになっているため、devではこのファイルは必須ではない。

# --- LINE Login / Messaging API（未設定ならLINEログインは無効。/api/auth/dev でdevログイン可）---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:8000/api/auth/line/callback
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# --- メール送信（Resend）---
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# --- Claude API（Phase 1以降のフィードバック生成で使用）---
ANTHROPIC_API_KEY=

# --- 本番ストレージ（Cloudflare R2）---
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- セッション ---
SESSION_SECRET=change-me-in-production

# --- GPU単価（08 §コストモデル。実測値で更新）---
GPU_UNIT_PRICE_AMOUNT=0.75
GPU_UNIT_PRICE_CURRENCY=USD
